{
  // Driftline Trading Hub. A separate project from Casey's business website.
  // Nothing here references driftlineprovisions.com or its app/database.
  // The app is named after the repository Cloudflare was connected to. The database keeps the hub's own name.
  "name": "alpaca-breakout-watcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // Keep the runtime variables Casey set in the dashboard when rebuilding this Worker.
  "keep_vars": true,
  "preview_urls": false,
  "observability": { "enabled": true },

  // Every five minutes during US market hours and the hour either side, weekdays.
  // Cloudflare's scheduler is used rather than GitHub Actions because the watcher's
  // own */5 cron on GitHub delivered about two runs a day before stopping entirely,
  // and a dropped scheduled run there does not fail, it simply never happens.
  // Previews never get this: checks/preview-isolation.mjs fails the build if a
  // schedule appears inside the previews block.
  "triggers": { "crons": ["*/5 13-21 * * 1-5"] },
  "ai": { "binding": "AI" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "driftline-trading-hub",
      "database_id": "a387a488-ba25-41c0-99f4-19cfda72f908",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "fb0359bca6414f97908b8bc84c88b464" }],

  // Every pull request gets its own Preview of this Worker at its own URL.
  // Previews inherit nothing from production, which is why wrangler refused to
  // deploy one at all while this block was missing: it will not quietly point
  // test code at Casey's real board. These are the separate test resources.
  // Nothing in here may ever name a database or namespace used above.
  //
  // Every Preview shares THIS database and THIS namespace. Separate URLs are not
  // separate state: two pull requests open at once read and write the same test
  // rows, and one that deletes or rewrites fixtures will pull them out from under
  // the other. Keep test fixtures additive, or give a branch its own database by
  // overriding previews.d1_databases and wrangler.preview-migrations.jsonc
  // together, which checks/preview-isolation.mjs requires to stay in step.
  "previews": {
    "vars": { "HUB_ENV": "preview" },
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "driftline-trading-hub-test",
        "database_id": "0a8e15e6-c7a2-4e22-b2d8-518593c869b5"
      }
    ],
    "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "4c9c1985ac9e448fa5931d9de60e4c74" }],
    "ai": { "binding": "AI" }
  }
}
