{
  // Driftline Trading Hub. A separate project from Casey's business website.
  // Nothing here references driftlineprovisions.com or its app/database.
  // The app is named after the repository Cloudflare was connected to. The database keeps the hub's own name.
  "name": "alpaca-breakout-watcher",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // Keep the runtime variables Casey set in the dashboard when rebuilding this Worker.
  "keep_vars": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "driftline-trading-hub",
      "database_id": "a387a488-ba25-41c0-99f4-19cfda72f908",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "fb0359bca6414f97908b8bc84c88b464" }]
}
