name: Install backtest lab

# One-time helper. Everything the backtest lab needs is packed inside this file,
# so nothing else has to be uploaded.
#
# How to use it from a phone (mobile browser, desktop site mode):
#   1. Put this file in the repo at .github/workflows/install-backtest-lab.yml
#   2. That commit starts this job by itself.
#   3. It writes the new files to a branch called "backtest-lab" and runs the tests.
#   4. Open that branch, look it over, then merge it into main.
#
# Nothing on main changes until you merge. The live paper ledger, the premarket
# state and the published dashboard data are never touched. The helper deletes
# itself on the branch, so it disappears when you merge.

on:
  push:
    paths:
      - ".github/workflows/install-backtest-lab*"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: install-backtest-lab
  cancel-in-progress: false

jobs:
  install:
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
