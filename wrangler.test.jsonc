{
  // Separate test Worker only. Replace the unprovisioned IDs after resource approval.
  // Never add routes, production secrets, AI, wake keys, or scheduled triggers here.
  "name": "driftline-hub-test",
  "main": "src/test-copy.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": false,
  "vars": { "HUB_TEST_COPY": "synthetic-only" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "driftline-trading-hub-test",
    "database_id": "0a8e15e6-c7a2-4e22-b2d8-518593c869b5",
    "migrations_dir": "migrations"
  }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "4c9c1985ac9e448fa5931d9de60e4c74" }]
}
